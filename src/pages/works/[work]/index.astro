---
import Layout from '../../../layouts/Layout.astro';import {catalog,href,episodesFor,readable,episodePath,isLocal,pageUrl,coverForWork} from '../../../lib/site';
export function getStaticPaths(){return catalog.works.map(work=>({params:{work:work.id},props:{work}}))}
const {work}=Astro.props;const arjuna=work.id==='arjuna';const philosophy=work.id==='philosophy-intro';const standalone=arjuna||philosophy;const episodes=episodesFor(work.id);const first=episodes.find(readable);const cover=coverForWork(work.id);const arcs=[...new Set(episodes.map(e=>e.arc||'各話'))];const collectionLabels=work.collectionIds.map((id:string)=>catalog.collections.find(c=>c.id===id)?.title).join(' / ');
---
<Layout title={work.title}><nav class="breadcrumb" aria-label="パンくず"><a href={href('/works/')}>作品一覧</a><span> / {work.title}</span></nav><header class="work-heading"><div><p class="eyebrow">{collectionLabels}</p><h1>{work.title}</h1><p class="lead">{work.summary}</p><p>{work.description}</p>{first&&<a class="button" href={href(episodePath(first))}>{standalone?`全${first.pages.length}ページを読む →`:<>第{first.order}話から読む →</>}</a>}</div>{cover&&<img class="work-cover" src={pageUrl(cover.episode,cover.page)} width={cover.page.width} height={cover.page.height} alt={`${work.title} 第${cover.episode.order}話の表紙ページ`}/>}</header>
{isLocal&&<aside class="notice"><strong>公開前のローカル閲覧について</strong><p>ここでは公開承認前の制作版を閲覧できます。各話の出典ページに記載した公開前確認事項が残っています。公開用の訂正版は、原版を残して別ファイルで作成します。</p></aside>}
{!isLocal&&first&&first.order>1&&<p class="notice">第1話は現在、公開準備中です。公開済みの第2話からお読みいただけます。</p>}
{arcs.map(arc=><section class="section"><p class="eyebrow">話の一覧</p><h2>{arc}</h2><ol class="episode-list">{episodes.filter(e=>(e.arc||'各話')===arc).map(e=><li id={`episode-${e.slug}`}><span class="episode-no">{String(e.order).padStart(2,'0')}</span><div><p class="meta">{philosophy?'カラー · 哲学':arjuna?'カラー · 人物入門':e.order===1?'パイロット · 白黒':e.pages.length?'カラー':'制作中'}{e.pages.length?` · 全${e.pages.length}ページ`:''}</p><h3>{readable(e)?<a href={href(episodePath(e))}>第{e.order}話 {e.title} <span aria-hidden="true">→</span></a>:<>第{e.order}話 {e.title}</>}</h3><p>{e.description}</p>{!readable(e)&&<span class="status">{e.productionStatus==='in_progress'?'制作中':'公開準備中'}</span>}</div></li>)}</ol></section>)}
<p class="reading-guide">{arjuna?'ページ内は上から下、同じ段では左から右に読みます。':'ページ内は上から下、同じ段では右から左に読みます。'}</p><section class="section prose"><h2>原典と漫画について</h2><p>会話・表情・情景等には漫画上の演出が含まれます。原典・出典の詳しい説明は、各話を読み終えた後に開けます。</p><a href={href('/editorial/')}>制作・出典方針 →</a></section></Layout>
