---
import Layout from '../../../../../layouts/Layout.astro';import {catalog,href,episodePath,readable} from '../../../../../lib/site';
export function getStaticPaths(){return catalog.episodes.filter(readable).map(episode=>({params:{work:episode.workId,episode:episode.slug},props:{episode}}))}
const {episode}=Astro.props;const source=catalog.sources.find(s=>s.id===episode.sourceId)!;
---
<Layout title={`原典・出典 — 第${episode.order}話 ${episode.title}`}><article class="prose"><nav class="breadcrumb"><a href={href(episodePath(episode))}>← 漫画へ戻る</a></nav><header class="page-heading"><p class="eyebrow">原典・出典</p><h1>第{episode.order}話<br/>{episode.title}</h1><p>物語のもとになった資料と、漫画として加えた表現について。</p></header><h2>{source.original}</h2><p>以下はこの話で扱う主な範囲です。範囲内の全節を描写しているという意味ではありません。</p><dl class="source-ranges">{source.ranges.map(r=><div><dt>{r.locator}</dt><dd>{r.event}</dd></div>)}</dl><h2>日本語表現について</h2><p>{source.textNote}</p><h2>漫画上の再構成・演出</h2><p>会話・表情・情景等には漫画上の演出が含まれます。</p><ul>{source.notes.map(n=><li>{n}</li>)}</ul><h2>参照資料</h2><ul class="reference-list">{source.references.map(r=><li><a href={r.url} rel="external noreferrer">{r.title} ↗</a><small>確認：{r.checked}</small></li>)}</ul><p class="small muted">ここでは制作時に記録した参照先を案内しています。このWeb実装時に全参照先の本文を再校閲したものではありません。</p><a class="button secondary" href={href(episodePath(episode))}>漫画へ戻る</a></article></Layout>
