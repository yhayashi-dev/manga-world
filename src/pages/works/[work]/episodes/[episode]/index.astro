---
import Layout from '../../../../../layouts/Layout.astro';import EpisodeNav from '../../../../../components/EpisodeNav.astro';import {catalog,href,workPath,readable,pageUrl,originalPageUrl,isLocal} from '../../../../../lib/site';import {orderedPages} from '../../../../../lib/catalog';
export function getStaticPaths(){return catalog.episodes.filter(readable).map(episode=>({params:{work:episode.workId,episode:episode.slug},props:{episode}}))}
const {episode}=Astro.props;const arjuna=episode.id==='ARJUNA';const philosophy=(episode.id==='PHILOSOPHY-INTRO'||episode.id==='PHILOSOPHY-KNOWLEDGE');const standalone=arjuna||philosophy;const work=catalog.works.find(w=>w.id===episode.workId)!;
---
<Layout title={`第${episode.order}話 ${episode.title} — ${work.title}`} reader>
<div class="reader-heading"><nav class="breadcrumb" aria-label="パンくず"><a href={href('/works/')}>作品一覧</a><span> / </span><a href={href(workPath(work.id))}>{work.title}</a></nav><p class="eyebrow">{work.title} / {episode.arc}</p><h1><span>第{episode.order}話</span> {episode.title}</h1><p class="meta">全{episode.pages.length}ページ{isLocal?(episode.id==='EP001'?' · 公開用新版・公開承認済み':' · 本番公開対象承認済み／デプロイ前'):''}</p><p class="reading-guide">{arjuna?'ページ内は上から下、同じ段では左から右に読みます。':'ページ内は上から下、同じ段では右から左に読みます。'}</p><p class="small muted">文字が小さい場合は、漫画画像をタップすると拡大できます。</p></div>
<div class="comic-pages">{orderedPages(episode.pages).map((p,i)=><figure id={`page-${String(p.order).padStart(2,'0')}`} data-page-id={p.id}><figcaption><span>{p.order} / {episode.pages.length}</span></figcaption><a class="comic-image-link" href={pageUrl(episode,p)} target="_blank" rel="noopener" aria-label={`${p.order}ページの画像を拡大（新しいタブ）`}><img class="comic-page" src={pageUrl(episode,p)} alt={`${work.title} 第${episode.order}話 ${p.order}ページ：${p.alt}`} width={p.width} height={p.height} loading={i===0?'eager':'lazy'} decoding="async" fetchpriority={i===0?'high':'auto'}/></a>{standalone&&<nav aria-label={`${p.order}ページの移動`} style="display:flex;flex-wrap:wrap;gap:1rem;padding:.75rem 0;justify-content:center">{i>0&&<a href={`#page-${String(p.order-1).padStart(2,'0')}`}>← 前のページ</a>}<a href="#page-01">先頭へ</a>{i<episode.pages.length-1&&<a href={`#page-${String(p.order+1).padStart(2,'0')}`}>次のページ →</a>}</nav>}</figure>)}</div>
<div class="reader-end">{isLocal&&<details class="original-comparison"><summary>検証用：受領PNGを開く</summary><p class="small">{episode.id==='EP001'?'表示は正式受領した新版8ページのロスレスWebPです。本番公開対象として承認済みです。旧白黒版と旧訂正版は別に保全し、旧版の本文由来・引用条件は未解決のままです。':episode.id==='EP003'?'表示は制作版完成画像から作成したロスレスWebPです。本番公開対象として承認済みです。物理スマホ確認は公開後に行います。':'表示は公開候補の検証用派生版です。第2話は文字と吹き出しを訂正し、本番公開対象として承認済みです。'}</p><p>{orderedPages(episode.pages).map(p=><a href={originalPageUrl(episode,p)} target="_blank" rel="noopener" aria-label={`${p.order}ページの制作原版を比較（新しいタブ）`}>P{String(p.order).padStart(2,'0')}　</a>)}</p></details>}<p class="episode-end">{standalone?'おわり':<>第{episode.order}話　おわり</>}</p>{standalone?<nav class="episode-nav" aria-label="作品の案内"><a href={href(workPath(work.id))}>作品紹介へ</a><a href={href('/works/')}>作品一覧へ</a><a href={href(`/works/${work.id}/episodes/${episode.slug}/sources/`)}>原典・出典へ</a></nav>:<EpisodeNav episode={episode}/>}<p class="adaptation-note">会話・表情・情景等には漫画上の演出が含まれます。</p></div></Layout>
